{
  "npm.scriptRunner": "vp",
  "oxc.fmt.disableNestedConfig": true,
  "oxc.disableNestedConfig": true,
  "editor.formatOnSaveMode": "file",
  "[typescript][typescriptreact][json][css]": {
    "editor.codeActionsOnSave": {
      "source.fixAll.oxc": "explicit"
    },
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  },
  "files.associations": {
    "*.css": "tailwindcss",
    "*.json": "json"
  },
  "files.exclude": {
    ".nitro": true,
    ".output": true,
    ".tanstack": true,
    ".wrangler": true,
    "node_modules": true
  },
  "files.readonlyInclude": {
    "**/route-tree.gen.ts": true,
    "src/components/ui/*": true,
    "src/hooks/use-mobile.ts": true,
    "src/lib/utils.ts": true
  },
  "files.watcherExclude": {
    "**/route-tree.gen.ts": true
  },
  "search.exclude": {
    "**/route-tree.gen.ts": true,
    "bun.lock": true
  },
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.preferences.autoImportFileExcludePatterns": ["react-day-picker", "radix-ui"],
  "typescript.preferences.importModuleSpecifier": "non-relative"
}
